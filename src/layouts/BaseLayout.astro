---
import '../styles/global.css';
import { site } from '../config/site';
import { buildJsonLd } from '../lib/jsonld';
import { fontPreloads } from '../lib/fonts';

interface Props {
  title?: string;
  description?: string;
  /** Sökväg relativ produktionsadressen, t.ex. "/" eller "/integritet/". */
  path?: string;
  /** Sätt true för sidor som inte ska indexeras (t.ex. 404). */
  noindex?: boolean;
  /** Bara startsidan bär det fullständiga JSON-LD-underlaget. */
  withJsonLd?: boolean;
}

const {
  title = site.meta.title,
  description = site.meta.description,
  path = '/',
  noindex = false,
  withJsonLd = false,
} = Astro.props;

const base = site.url.replace(/\/$/, '');
const canonical = `${base}${path}`;
const ogImage = `${base}${site.meta.ogImage}`;
// Förhandsvisningar hålls utanför indexering med PUBLIC_NOINDEX=1 vid bygget.
const previewNoindex = import.meta.env.PUBLIC_NOINDEX === '1';
const robots = noindex || previewNoindex ? 'noindex, nofollow' : 'index, follow';
const jsonLd = withJsonLd ? JSON.stringify(buildJsonLd()) : null;
---

<!doctype html>
<html lang={site.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.meta.themeColor} />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.meta.ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#innehall">Hoppa till innehållet</a>
    <slot />
  </body>
</html>
