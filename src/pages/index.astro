---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Idea from '../components/story/Idea.astro';
import Origin from '../components/story/Origin.astro';
import Cycle from '../components/story/Cycle.astro';
import Model from '../components/story/Model.astro';
import Career from '../components/story/Career.astro';
import Value from '../components/story/Value.astro';
import Proof from '../components/story/Proof.astro';
import Direction from '../components/story/Direction.astro';
import Invitation from '../components/story/Invitation.astro';
import Footer from '../components/Footer.astro';
import FilmDialog from '../components/FilmDialog.astro';
---

<BaseLayout path="/" withJsonLd={true}>
  <Header home={true} />
  <main id="innehall">
    <Idea />
    <Origin />
    <Cycle />
    <Model />
    <Career />
    <Value />
    <Proof />
    <Direction />
    <Invitation />
  </main>
  <Footer />
  <FilmDialog />
</BaseLayout>

<script>
  import '../scripts/main';
</script>
