---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, site } from '../config/site';
import { resolveBooking } from '../lib/booking';
const b = resolveBooking();
const title = `${copy.notFound.title} | ${site.name}`;
// Samma mål som huvudknapparna: mejlförslag i contact_only, extern sida, eller inbjudan på startsidan.
---

<BaseLayout title={title} description={copy.notFound.text} path="/404/" noindex={true}>
  <Header />
  <main id="innehall" class="notfound">
    <div class="notfound__inner">
      <h1>{copy.notFound.title}</h1>
      <p>{copy.notFound.text}</p>
      <div class="notfound__actions">
        <a class="btn" href="/">{copy.notFound.linkLabel}</a>
        <a class="quiet-link" href={b.href} rel={b.external ? 'noopener' : undefined} target={b.external ? '_blank' : undefined} data-event={b.openEvent}>{b.ctaFull}{b.external && <span class="visually-hidden"> (öppnas i nytt fönster)</span>}</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
