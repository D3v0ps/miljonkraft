---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { booking, contact, organization, site } from '../config/site';
const title = `Integritetsinformation | ${site.name}`;
// Med inbäddad Bookings-kalender sätter Microsoft egna kakor. Texten följer därför bokningsläget.
const embedded = booking.mode === 'shared_embed';
const description = embedded
  ? 'Så hanteras uppgifter på miljonkraft.se. Sidan sätter inga egna kakor. Bokningskalendern från Microsoft Bookings sätter sina egna.'
  : 'Så hanteras uppgifter på miljonkraft.se. Webbplatsen samlar inte in personuppgifter och använder inga kakor.';
const lead = embedded
  ? 'Miljonkraft.se sätter inga egna kakor och har ingen besöksstatistik. Öppnar ni bokningskalendern laddas Microsoft Bookings, som sätter egna kakor och tar emot de uppgifter ni fyller i.'
  : 'Miljonkraft.se är en informationssida. Den samlar inte in personuppgifter, använder inga kakor och har ingen besöksstatistik.';
---

<BaseLayout title={title} description={description} path="/integritet/">
  <Header />
  <main id="innehall" class="subpage">
    <div class="subpage__inner">
      <h1>Så hanteras era uppgifter</h1>
      <p class="subpage__lead">{lead}</p>
      <h2>När ni kontaktar oss</h2>
      <p>Kontaktvägarna på sidan är vanliga länkar till telefon och mejl. När ni mejlar eller ringer hanteras uppgifterna av {organization.name}, som ansvarar för behandlingen. Uppgifterna används bara för att svara på er förfrågan och boka ett samtal.</p>
      <h2>Bokning</h2>
      {booking.mode === 'contact_only' ? (
        <p>Sidan har ingen bokningskalender. Ni föreslår en tid i ett mejl, och uppgifterna hanteras som när ni kontaktar oss.</p>
      ) : (
        <p>Bokningen sker i Microsoft Bookings och hanteras i {organization.name}s Microsoft 365-miljö. Namn och mejladress behövs för att skicka en bekräftelse.</p>
      )}
      <h2>Frågor</h2>
      <p>Hör av er till <a href={`mailto:${contact.email}`}>{contact.email}</a> eller läs mer om <a href={organization.url} rel="noopener">{organization.name}</a>.</p>
      <p class="subpage__meta">Senast uppdaterad {site.lastModified}.</p>
      <p><a class="quiet-link" href="/">Till startsidan</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
