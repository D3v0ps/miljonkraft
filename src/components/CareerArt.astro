---
/**
 * Egna linjeillustrationer för de steg i Karriärstegen som saknar foto.
 * Dekorativa. Linjerna ritas fram när steget avtäcks. Röd punkt som accent enligt profilen.
 */
interface Props { art: 'truck' | 'system' | 'network' }
const { art } = Astro.props;
---
<span class="path__art" aria-hidden="true">
  {art === 'truck' && (
    <svg viewBox="0 0 200 180" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
      <path pathLength="1" d="M146 22 V150" />
      <path pathLength="1" d="M156 22 V150" />
      <path pathLength="1" d="M141 30 H161 M141 70 H161 M141 110 H161" />
      <path pathLength="1" d="M156 150 H196 V144" />
      <path pathLength="1" d="M160 106 H194 V140 H160 Z" />
      <path pathLength="1" d="M160 118 H194 M177 106 V140" />
      <path pathLength="1" d="M74 104 L84 50 H136 V104" />
      <path pathLength="1" d="M28 150 V104 H146 V150" />
      <path pathLength="1" d="M28 128 H52 M28 116 H52" />
      <path pathLength="1" d="M92 104 V86 H110" />
      <circle pathLength="1" cx="62" cy="152" r="16" />
      <circle pathLength="1" cx="122" cy="154" r="13" />
      <path pathLength="1" d="M4 172 H196" />
      <circle class="path__art-dot" cx="110" cy="38" r="8" />
    </svg>
  )}
  {art === 'system' && (
    <svg viewBox="0 0 200 180" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
      <path pathLength="1" d="M20 14 V172 M180 14 V172" />
      <path pathLength="1" d="M20 62 H180 M20 112 H180 M20 162 H180" />
      <path pathLength="1" d="M30 62 V30 H70 V62 M78 62 V40 H104 V62 M114 62 V24 H164 V62" />
      <path pathLength="1" d="M30 112 V88 H58 V112 M66 112 V76 H120 V112 M130 112 V92 H170 V112" />
      <path pathLength="1" d="M30 162 V132 H82 V162 M92 162 V140 H118 V162 M128 162 V126 H170 V162" />
      <path pathLength="1" d="M66 94 H120" />
      <circle class="path__art-dot" cx="93" cy="58" r="8" />
    </svg>
  )}
  {art === 'network' && (
    <svg viewBox="0 0 200 180" fill="none" stroke="currentColor" stroke-width="3">
      <path pathLength="1" d="M100 90 L36 42 M100 90 L164 42 M100 90 L30 128 M100 90 L170 128 M100 90 L100 22 M100 90 L100 162" />
      <path pathLength="1" d="M36 42 L100 22 L164 42 M30 128 L100 162 L170 128" stroke-dasharray="0.02 0.02" class="path__art-dash" />
      <circle pathLength="1" cx="36" cy="42" r="10" />
      <circle pathLength="1" cx="164" cy="42" r="10" />
      <circle pathLength="1" cx="30" cy="128" r="10" />
      <circle pathLength="1" cx="170" cy="128" r="10" />
      <circle pathLength="1" cx="100" cy="22" r="10" />
      <circle pathLength="1" cx="100" cy="162" r="10" />
      <circle class="path__art-dot" cx="100" cy="90" r="17" />
    </svg>
  )}
</span>
