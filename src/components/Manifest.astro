---
import { copy } from '../config/site';
import fit from '../lib/type-fit.json';
const m = copy.manifest;
// "*text*" markerar den fetade delen av varje mening.
const parts = (t: string) => t.split('*').map((p, i) => ({ p, bold: i % 2 === 1 }));
---

<section class="section manifest" id={m.id} aria-labelledby="manifest-heading" data-progress="through">
  <div class="container">
    <p class="label label--dot" data-reveal>{m.label}</p>
    <h2 id="manifest-heading" class="manifest__title">
      <span class="manifest__intro thin" data-reveal>{m.intro}</span>
      <span class="manifest__word" style={`--k:${fit.manifest}`}>
        <span class="manifest__outline" aria-hidden="true">{m.word}</span>
        <span class="manifest__fill">{m.word}</span>
      </span>
    </h2>
    <p class="manifest__rest" data-reveal>{m.rest}</p>

    <ol class="manifest__list">
      {m.lines.map((l, i) => (
        <li class="manifest__item" data-reveal style={`transition-delay:${i * 120}ms`}>
          <span class="manifest__num" aria-hidden="true">0{i + 1}</span>
          <span class="manifest__art" aria-hidden="true">
            {l.art === 'door' && (
              <svg viewBox="0 0 160 140" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
                <path pathLength="1" d="M40 132 V12 H110 V132" />
                <path pathLength="1" d="M40 12 L74 22 V124 L40 132" />
                <path pathLength="1" d="M118 40 L150 28 M118 70 H154 M118 100 L150 112" />
                <path pathLength="1" d="M6 132 H154" />
                <circle class="manifest__dot" cx="64" cy="76" r="6" />
              </svg>
            )}
            {l.art === 'growth' && (
              <svg viewBox="0 0 160 140" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
                <path pathLength="1" d="M8 132 H40 V104 H72 V76 H104 V48 H136 V20" />
                <path pathLength="1" d="M8 132 H154" />
                <path pathLength="1" d="M40 132 V104 M72 132 V76 M104 132 V48 M136 132 V20" stroke-dasharray="0.03 0.03" class="manifest__dash" />
                <circle class="manifest__dot" cx="136" cy="14" r="9" />
              </svg>
            )}
            {l.art === 'city' && (
              <svg viewBox="0 0 160 140" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
                <path pathLength="1" d="M10 132 V70 H38 V132 M46 132 V30 H80 V132 M88 132 V54 H116 V132 M124 132 V84 H150 V132" />
                <path pathLength="1" d="M54 44 H72 M54 60 H72 M54 76 H72 M54 92 H72 M54 108 H72 M18 84 H30 M18 100 H30 M96 68 H108 M96 84 H108 M96 100 H108 M132 98 H142 M132 112 H142" />
                <path pathLength="1" d="M4 132 H156" />
                <circle class="manifest__dot" cx="128" cy="30" r="12" />
              </svg>
            )}
          </span>
          <p class="manifest__text">
            {parts(l.text).map((x) => (x.bold ? <strong>{x.p}</strong> : x.p))}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
