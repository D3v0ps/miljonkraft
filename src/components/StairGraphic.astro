---
/**
 * Sidans grafiska huvudgrepp. En trappa med åtta steg som stiger åt höger,
 * ett per steg i Miljonmodellen. Linjen börjar i en fylld nod och slutar i en
 * ihålig nod, nästa steg som ännu inte är taget. Dekorativ, modellens steg
 * finns som text i #miljonmodellen.
 */
interface Props { class?: string; steps?: number; riser?: number; height?: number }
const { class: className, steps = 8, riser = 42, height = 400 } = Astro.props;
const W = 640, H = height, pad = 10, baseY = H - pad - 4, tread = (W - pad * 2) / steps;
const pts: string[] = [];
let x = pad, y = baseY;
pts.push(`${x},${y}`);
for (let i = 0; i < steps; i++) {
  y -= riser;
  pts.push(`${x},${y}`);
  x += tread;
  pts.push(`${x},${y}`);
}
const line = pts.join(' ');
const topY = baseY - riser * steps;
const endX = pad + tread * steps;
---
<svg class={className} viewBox={`0 0 ${W} ${H}`} width={W} height={H} fill="none" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMax meet">
  <polyline class="stair__line" points={line} stroke-width="2.5" stroke-linejoin="miter" vector-effect="non-scaling-stroke" pathLength="1" />
  <rect class="stair__start" x={pad - 5} y={baseY - 5} width="10" height="10" />
  <line class="stair__top" x1={endX - tread} y1={topY} x2={endX} y2={topY} stroke-width="5" vector-effect="non-scaling-stroke" />
  <rect class="stair__end" x={endX - 6} y={topY - 6} width="12" height="12" stroke-width="2.5" vector-effect="non-scaling-stroke" />
</svg>
