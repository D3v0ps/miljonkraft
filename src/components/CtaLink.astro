---
/**
 * Huvudknappen. Båda texterna finns i HTML, CSS avgör vilken som visas.
 * I contact_only öppnar den ett förifyllt mejl och heter aldrig Boka.
 */
import { resolveBooking } from '../lib/booking';
interface Props { class?: string; cta: string }
const { class: className = '', cta } = Astro.props;
const b = resolveBooking();
// Ord med bindestreck, som 30-minuters, bryts aldrig mitt i.
const parts = b.ctaFull.split(/(\S+-\S+)/);
---
<a
  class={`btn ${className}`.trim()}
  href={b.href}
  target={b.external ? '_blank' : undefined}
  rel={b.external ? 'noopener' : undefined}
  data-cta={cta}
  data-event={b.openEvent}
>
  <span class="cta-full">{parts.map((p) => (/-/.test(p) ? <span class="nw">{p}</span> : p))}</span><span class="cta-short">{b.ctaShort}</span>
  {b.external && <span class="visually-hidden"> (öppnas i nytt fönster)</span>}
</a>
