---
import { copy } from '../config/site';
const m = copy.model;
---

<section class="section section--tint model" id={m.id} aria-labelledby="model-heading">
  <div class="section__inner">
    <div class="section__intro model__intro">
      <h2 id="model-heading">{m.heading}</h2>
      {m.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <p class="steps-label" id="steps-label">{m.stepsLabel}</p>
    <ol class="steps" aria-labelledby="steps-label">
      {m.steps.map((s) => (
        <li>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
