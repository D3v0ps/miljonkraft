---
import { copy } from '../config/site';
import { splitHeading } from '../lib/heading';
const m = copy.model;
const [bold, thin] = splitHeading(m.heading, 1);
---

<section class="section section--gra model" id={m.id} aria-labelledby="model-heading">
  <div class="container">
    <div class="head">
      <div class="head__col">
        <p class="label label--dot" data-reveal>Så arbetar vi</p>
        <h2 id="model-heading" class="head__title" data-reveal>{bold} <span class="thin">{thin}</span></h2>
      </div>
      <div class="info" data-reveal>
        {m.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ol class="model__steps" aria-label={m.stepsLabel} data-steps>
      {m.steps.map((s, i) => (
        <li class="step" style={`--i:${i}`}>
          <h3 class="step__name">{s.name}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
