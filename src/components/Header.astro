---
import { nav, site } from '../config/site';
import MbLogo from './MbLogo.astro';
import CtaLink from './CtaLink.astro';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="#top" aria-label={`${site.name}, ett initiativ från Miljonbemanning. Till sidans början`}>
      <MbLogo height={26} alt="" />
      <span class="brand__rule" aria-hidden="true"></span>
      <span class="brand__name"><b>Miljonkraft</b> Botkyrka</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
      <span class="menu-toggle__label" data-menu-label-open>Meny</span>
      <span class="menu-toggle__label" data-menu-label-close hidden>Stäng</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
    </button>

    <noscript>
      <style>@media (max-width: 1023.98px) { .primary-nav:not(.is-visible) { display: block; } .menu-toggle { display: none; } }</style>
    </noscript>
    <nav class="primary-nav" id="primary-nav" aria-label="Huvudmeny" data-primary-nav>
      <ul class="primary-nav__list">
        {nav.items.map((item) => (
          <li><a class="primary-nav__link" href={item.href}>{item.label}</a></li>
        ))}
        <li class="primary-nav__cta">
          <CtaLink class="btn--small" cta="nav" forceShort={true} />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobilmeny. Innehållet finns i HTML redan, skriptet styr bara öppet och stängt läge.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navEl = document.querySelector<HTMLElement>('[data-primary-nav]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const labelOpen = document.querySelector<HTMLElement>('[data-menu-label-open]');
  const labelClose = document.querySelector<HTMLElement>('[data-menu-label-close]');

  if (toggle && navEl && header) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      if (labelOpen && labelClose) {
        labelOpen.hidden = open;
        labelClose.hidden = !open;
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    navEl.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    header.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !header.contains(next)) setOpen(false);
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));

    // Sidhuvudet får bakgrund först när sidan har skrollats.
    const sync = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
