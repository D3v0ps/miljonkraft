---
import { nav, site } from '../config/site';
import Mark from './Mark.astro';
import CtaLink from './CtaLink.astro';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="brand" href="#top" aria-label={`${site.name}, till sidans början`}>
      <Mark class="brand__mark" />
      <span class="brand__text"><span class="brand__name">Miljonkraft</span> <span class="brand__place">Botkyrka</span></span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-toggle__label" data-menu-label-open>Meny</span>
      <span class="menu-toggle__label" data-menu-label-close hidden>Stäng</span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Huvudmeny" data-primary-nav>
      <ul class="primary-nav__list">
        {nav.items.map((item) => (
          <li><a class="primary-nav__link" href={item.href}>{item.label}</a></li>
        ))}
        <li class="primary-nav__cta">
          <CtaLink class="button--small" cta="nav" forceShort={true} />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobilmeny. Innehållet finns i HTML redan; skriptet styr bara öppet/stängt läge.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navEl = document.querySelector<HTMLElement>('[data-primary-nav]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const labelOpen = document.querySelector<HTMLElement>('[data-menu-label-open]');
  const labelClose = document.querySelector<HTMLElement>('[data-menu-label-close]');

  if (toggle && navEl && header) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (labelOpen && labelClose) {
        labelOpen.hidden = open;
        labelClose.hidden = !open;
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    navEl.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    // Stäng när menyn tappar fokus (tangentbord) och fokus hamnar utanför sidhuvudet.
    header.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !header.contains(next)) setOpen(false);
    });
    const mq = window.matchMedia('(min-width: 900px)');
    mq.addEventListener('change', () => setOpen(false));
  }
</script>
