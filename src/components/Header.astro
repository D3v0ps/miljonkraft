---
import { site } from '../config/site';
import MbLogo from './MbLogo.astro';
import CtaLink from './CtaLink.astro';
interface Props { home?: boolean }
const { home = false } = Astro.props;
---
<header class="hdr" id={home ? "top" : undefined}>
  <div class="hdr__in">
    <a class="brand" href={home ? '#top' : '/'} aria-label={`${site.name}, ett initiativ från Miljonbemanning. ${home ? 'Till sidans början' : 'Till startsidan'}`}>
      <MbLogo height={22} alt="" />
      <span class="brand__name">Miljonkraft <span class="brand__place">Botkyrka</span></span>
    </a>
    <CtaLink class="btn--sm" cta="header" />
  </div>
</header>
