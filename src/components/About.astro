---
import { copy, images } from '../config/site';
import { splitHeading } from '../lib/heading';
import Photo from './Photo.astro';
const a = copy.about;
const [bold, thin] = splitHeading(a.heading, 2);
---

<section class="section about" id={a.id} aria-labelledby="about-heading">
  <div class="container">
    <div class="about__grid">
      <div class="panel about__photo" data-wipe>
        <Photo img={images.mbVastPortrait} widths={images.mbVastPortrait.widths} sizes="(min-width: 1024px) 38vw, 92vw" />
      </div>

      <div class="about__content">
        <p class="label label--dot" data-reveal>{a.label}</p>
        <h2 id="about-heading" class="head__title" data-reveal>{bold} <span class="thin">{thin}</span></h2>
        <div class="about__text" data-reveal>
          {a.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <dl class="facts">
          {a.facts.map((f) => (
            <div class="fact" data-reveal>
              <dt class="fact__value">{f.value}</dt>
              <dd class="fact__text">{f.text}</dd>
            </div>
          ))}
        </dl>

      </div>
    </div>

    <div class="quotes">
      {a.quotes.filter((q) => !q.featured).map((q) => (
        <figure class="quote" data-reveal>
          <blockquote cite={q.source}><p>{q.text}</p></blockquote>
          <figcaption>
            <strong>{q.who}</strong>
            {q.context}. <a href={q.source} rel="noopener">{a.sourceLabel}</a>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="awards" data-reveal>
      <p class="label" id="awards-label">{a.awardsLabel}</p>
      <ul class="awards__list" aria-labelledby="awards-label">
        {a.awards.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </div>
</section>
