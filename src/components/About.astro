---
import { copy, images } from '../config/site';
import { splitHeading } from '../lib/heading';
import Photo from './Photo.astro';
const a = copy.about;
const [bold, thin] = splitHeading(a.heading, 2);
---

<section class="section about" id={a.id} aria-labelledby="about-heading">
  <div class="container">
    <div class="about__grid">
      <div class="panel about__photo" data-wipe>
        <Photo img={images.mbVastPortrait} widths={images.mbVastPortrait.widths} sizes="(min-width: 1540px) 590px, (min-width: 1024px) 38vw, 92vw" />
      </div>

      <div class="about__content">
        <div class="head__col">
          <p class="label label--dot" data-reveal>{a.label}</p>
          <h2 id="about-heading" class="head__title" data-reveal>{bold} <span class="thin">{thin}</span></h2>
        </div>
        <div class="about__text info" data-reveal>
          {a.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
