---
/** Ett litet trappsteg med fylld nod. Används där vägen från heron kommer fram. Dekorativ. */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={className} width="48" height="20" viewBox="0 0 48 20" fill="none" aria-hidden="true" focusable="false">
  <path d="M0 18h18v-14h30" stroke="var(--line-strong)" stroke-width="2.5" />
  <line x1="30" y1="4" x2="48" y2="4" stroke="var(--accent)" stroke-width="4" />
  <rect x="40" y="0" width="8" height="8" fill="var(--accent)" />
</svg>
