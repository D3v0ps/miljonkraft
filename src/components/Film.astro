---
import { copy } from '../config/site';
import { film } from '../lib/film';
import { splitHeading } from '../lib/heading';
const f = copy.film;
const [bold, thin] = splitHeading(f.heading, 1);
const fmt = (s: number) => `${Math.floor(s / 60)}.${String(Math.round(s % 60)).padStart(2, '0')}`;
---

{film.available && (
  <section class="section film" id={f.id} aria-labelledby="film-heading">
    <div class="container">
      <div class="head">
        <div>
          <p class="label label--dot" data-reveal>{f.label}</p>
          <h2 id="film-heading" class="head__title" data-reveal>{bold} <span class="thin">{thin}</span></h2>
        </div>
        <p class="info film__note" data-reveal>{f.note}</p>
      </div>

      <div class="film__frame" data-film data-wipe>
        <video
          controls
          playsinline
          preload="none"
          poster={film.poster}
          width="1920"
          height="1080"
          aria-describedby="film-text-summary"
          data-film-video
        >
          {film.webm && <source src={film.webm} type="video/webm" />}
          {film.mp4Small && <source src={film.mp4Small} type="video/mp4" media="(max-width: 760px)" />}
          <source src={film.mp4} type="video/mp4" />
          {film.chapters && <track kind="chapters" src={film.chapters} srclang="sv" label="Kapitel" default />}
          <a href={film.mp4}>Ladda ner filmen</a>
        </video>
        <button type="button" class="film__play" data-film-play hidden>
          <span class="film__play-inner">
            <span class="film__play-icon" aria-hidden="true">
              <svg viewBox="0 0 12 14" fill="currentColor"><path d="M0 0v14l12-7z" /></svg>
            </span>
            {f.play}
          </span>
        </button>
      </div>

      {film.scenes.length > 0 && (
        <details class="film__text">
          <summary id="film-text-summary">{f.textToggle}</summary>
          <ol>
            {film.scenes.map((s) => (
              <li><span class="film__time">{fmt(s.start)}</span> {s.text.join(' ')}</li>
            ))}
          </ol>
        </details>
      )}
    </div>
  </section>
)}

<script>
  // Filmen startar bara när besökaren trycker på spela. Ljudet följer med eftersom det är ett aktivt val.
  const frame = document.querySelector<HTMLElement>('[data-film]');
  const video = document.querySelector<HTMLVideoElement>('[data-film-video]');
  const play = document.querySelector<HTMLButtonElement>('[data-film-play]');
  if (frame && video && play) {
    video.controls = false;
    play.hidden = false;
    const start = () => {
      play.hidden = true;
      video.controls = true;
      video.muted = false;
      const p = video.play();
      if (p) p.catch(() => { video.controls = true; });
      video.focus();
    };
    play.addEventListener('click', start);
    video.addEventListener('ended', () => {
      video.controls = false;
      video.currentTime = 0;
      video.load();
      play.hidden = false;
    });
    // Länken Se filmen i hero startar filmen direkt i samma klick.
    document.querySelectorAll<HTMLAnchorElement>('[data-film-jump]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        frame.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        history.replaceState(null, '', '#filmen');
        start();
      }),
    );
  }
</script>
