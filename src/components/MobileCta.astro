---
import CtaLink from './CtaLink.astro';
---

<aside class="mobile-cta" data-mobile-cta hidden aria-label="Kontakt">
  <CtaLink cta="mobile" forceShort={true} />
</aside>

<script>
  // Fast knapp på mobil. Visas när hero-knappen har skrollats förbi och döljs vid bokningssektionen,
  // så att innehåll, fokus och sidfot förblir åtkomliga.
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const heroCta = document.querySelector<HTMLElement>('[data-cta="primary"]');
  const bookingSection = document.getElementById('boka');
  const narrow = window.matchMedia('(max-width: 1023.98px)');
  if (bar && heroCta && bookingSection) {
    bar.hidden = false;
    const syncWidth = () => document.documentElement.classList.toggle('has-mobile-cta', narrow.matches);
    syncWidth();
    narrow.addEventListener('change', syncWidth);
    let passedHero = false;
    let bookingVisible = false;
    const update = () => {
      const visible = passedHero && !bookingVisible;
      bar.classList.toggle('is-visible', visible);
      bar.inert = !visible;
    };
    // Läget räknas vid varje skroll, så att även hopp via menylänkar (som aldrig passerar knappen) ger rätt läge.
    let queued = false;
    const check = () => {
      queued = false;
      const vh = window.innerHeight;
      passedHero = heroCta.getBoundingClientRect().bottom < 0;
      const r = bookingSection.getBoundingClientRect();
      bookingVisible = r.top < vh * 0.85 && r.bottom > vh * 0.15;
      update();
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(check);
    };
    check();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
