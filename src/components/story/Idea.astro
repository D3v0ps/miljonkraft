---
import { copy, images } from '../../config/site';
import { lane } from '../../lib/thread';
import Thread from '../Thread.astro';
import CtaLink from '../CtaLink.astro';
const c = copy.idea;
const art = images.torg;
---
<section class="ch ch--idea" id={c.id} aria-labelledby="idea-h">
  <div class="seg seg--idea">
    <Thread class="t--idea" narrow={lane(14, 25, true)} />
    <span class="meet" aria-hidden="true"><span class="meet__a"></span><span class="meet__b"></span></span>
    <div class="seg__in idea">
      <h1 id="idea-h" class="idea__h">{c.headline}</h1>
      <p class="idea__lead">{c.lead}</p>
      <p class="idea__actions">
        <CtaLink class="btn--lg" cta="primary" />
        <a class="quiet-link" href={c.readMoreHref}><span class="quiet-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>{c.readMore}</a>
      </p>
      <figure class="idea__art">
        <picture>
          <source type="image/webp" srcset={art.widths.map((w) => `${art.src}-${w}.webp ${w}w`).join(', ')} sizes="(min-width: 960px) 560px, calc(100vw - 80px)" />
          <img src={`${art.src}-680.jpg`} width={art.w} height={art.h} alt={art.alt} decoding="async" />
        </picture>
        <figcaption>{art.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>
