---
import { copy } from '../config/site';
import fit from '../lib/type-fit.json';
import { splitHeading } from '../lib/heading';
const v = copy.vision;
const [bold, thin] = splitHeading(v.heading, 3);
const [statement, ...rest] = v.paragraphs;
---

<section class="section vision" id={v.id} aria-labelledby="vision-heading">
  <span class="vision__sun" aria-hidden="true"></span>
  <div class="container">
    <p class="label label--dot" data-reveal>{v.label}</p>
    <p class="vision__poster" aria-hidden="true" data-reveal>
      <span class="thin" style={`--k:${fit['vision-1']}`}>{v.poster[0]}</span>
      <span style={`--k:${fit['vision-2']}`}>{v.poster[1]}<span class="dot">.</span></span>
    </p>
    <div class="vision__cols">
      <div>
        <h2 id="vision-heading" class="vision__heading" data-reveal>{bold} <span class="thin">{thin}</span></h2>
        <p class="vision__statement" data-reveal>{statement}</p>
      </div>
      <div class="info vision__text" data-reveal>
        {rest.map((p) => <p>{p}</p>)}
        <p class="status-note vision__status">{copy.status.text}</p>
      </div>
    </div>
  </div>
</section>
